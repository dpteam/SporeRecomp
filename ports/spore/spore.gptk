# GPTOKEYB profile for Spore (RG 35 XX H / muOS).
#
# Spore is a mouse-driven game: "go here / action" is a left click, "fly to" is a right
# click, camera rotation is a middle-drag, and zoom is the wheel. So the pad is mapped to
# keyboard *and* mouse, following the game's own default bindings (spore.com/comm/tutorials/
# controls):
#
#   A            left click      go here / action / select / use tool   <- the main button
#   B            right click     fly to / action
#   X            space           jump, flap wings, toggle units
#   Y            tab             verb tray / tools palette
#   L1 / R1      q / e           strafe left / right
#   L2 / R2      - / +           zoom camera out / in
#   Start        return          accept (green checkmark)
#   Select       escape          deselect / options / close dialog
#   D-Pad        arrows          move camera, menu navigation
#   Left stick   w a s d         move avatar / drive creature / ship
#   Right stick  mouse           camera pitch and rotate
#   R3           backspace       mating call / locating call / camera to hut
#
# Keyboard-only fallback keys are kept where they do not conflict, so the port is usable
# before the DirectInput layer exists.
back = esc
start = return

a = mouse_left
b = mouse_right
x = space
y = tab

l1 = q
r1 = e
l2 = minus
r2 = equal

up = up
down = down
left = left
right = right

left_analog_up = w
left_analog_down = s
left_analog_left = a
left_analog_right = d

right_analog_up = mouse_up
right_analog_down = mouse_down
right_analog_left = mouse_left
right_analog_right = mouse_right

deadzone_mode = axial
deadzone = 3000
# The right stick drives the camera; keep it slow enough to aim with.
mouse_scale = 1200

hotkey = select
hotkey_start = esc
